# ---- Supabase (obrigatório) ----
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# Chave secreta (service_role). Usada SOMENTE no servidor para o admin criar/remover usuários.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Geração de fundo da arte com IA (opcional) ----
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- WhatsApp Business Cloud API (opcional) ----
# Sem estas variáveis o sistema usa o compartilhamento nativo (abre o WhatsApp com a mensagem pronta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
